# Copy to .env in the project root (never commit .env).
APP_ENV=development
# Development default is fine locally. In production use a long random value: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
DATABASE_URL=postgresql+psycopg2://careerpilot:careerpilot@localhost:5432/careerpilot
REDIS_URL=redis://localhost:6379/0
# Comma-separated browser origins allowed to call the API. localhost on any port is also allowed unless APP_ENV=production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional. Leave blank to use the labelled demo narrative / demo resource catalog.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
TAVILY_API_KEY=
